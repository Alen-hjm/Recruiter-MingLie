MINGLIE_PORT=5050
MINGLIE_DATABASE=instance/minglie.db
# playwright: visible persistent browser for real recruiting tasks; demo: local test data only
MINGLIE_SEARCH_PROVIDER=playwright
MINGLIE_BROWSER_DATA_DIR=instance/browser_data
MINGLIE_PLAYWRIGHT_CHANNEL=chrome
MINGLIE_SCRAPE_MAX_PAGES=3
# Optional OpenAI-compatible model endpoint. Leave blank to use deterministic rule scoring.
MINGLIE_AI_BASE_URL=
MINGLIE_AI_API_KEY=
MINGLIE_AI_MODEL=
