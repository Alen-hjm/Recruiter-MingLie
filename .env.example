# 明猎 · 环境变量示例
# 复制为 .env 后按需修改；.env 已在 .gitignore 中排除，不会进版本库。
#
# 载入方式（任选其一）：
#   1) 手动导出：PowerShell  $env:MINGLIE_LLM_API_KEY="sk-..."
#   2) 用 python-dotenv：在 run.py 顶部加 from dotenv import load_dotenv; load_dotenv()

# ============ 必填（可选，也可在网页「设置」页填写） ============
# 大模型 API Key。留空则完全依赖网页设置页里保存的值。
# 建议配在这里：数据库文件一旦外泄，Key 不会跟着泄露。
MINGLIE_LLM_API_KEY=
MINGLIE_LLM_BASE_URL=https://api.deepseek.com
MINGLIE_LLM_MODEL=deepseek-chat

# ============ 安全（生产环境强烈建议显式设置） ============
# Flask 会话签名密钥。不设的话会自动生成并持久化到 data/.secret_key，
# 本地单机够用；多实例部署或容器化时应当显式注入同一个值。
MINGLIE_SECRET_KEY=

# 允许的扩展来源白名单（逗号分隔）。留空 = 放开 chrome-extension://* 与本地回环。
# 生产环境建议填入扩展安装后的确切 ID：
#   MINGLIE_EXTENSION_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
MINGLIE_EXTENSION_ORIGINS=

# 是否接受「LLM Key 当作扩展凭据」的旧通道。默认 true 是为了不打断已在用的旧扩展。
# 完成迁移后应当设为 0，届时扩展必须使用 /api/tokens 签发的 X-API-Token。
MINGLIE_ALLOW_LEGACY_KEY_AUTH=1

# 每个用户最多保留多少个有效令牌
MINGLIE_MAX_TOKENS_PER_USER=20

# ============ 运行 ============
MINGLIE_ENV=development
MINGLIE_DEBUG=0
MINGLIE_HOST=127.0.0.1
MINGLIE_PORT=5000
MINGLIE_MAX_BODY_MB=32

# ============ 路径（默认都在项目目录下） ============
# MINGLIE_DATA_DIR=D:/minglie-data
# MINGLIE_BROWSER_DIR=D:/minglie-browser
# MINGLIE_SCREENSHOT_DIR=D:/minglie-shots

# ============ 猎聘抓取 ============
# CDP 模式连接的 Chrome 调试端口
MINGLIE_CDP_PORT=9222
# 抓取时是否无头（猎聘建议 false，无头更容易被识别）
MINGLIE_SCRAPE_HEADLESS=0
MINGLIE_SCRAPE_TIMEOUT_MS=30000
MINGLIE_SCRAPE_MAX_PAGES=5
